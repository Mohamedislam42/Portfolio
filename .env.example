# ==============================================================================
# Mohamed Elshourbagy Portfolio — Environment Variables Configuration
# ==============================================================================

# Contact Form — Resend API Configuration
# 1. Create a free account at https://resend.com
# 2. Obtain your API key from the Resend dashboard (starts with re_...)
# 3. Add to your local .env.local file or Vercel Project Environment Variables
RESEND_API_KEY=re_your_api_key_here

# The destination email address where contact messages are delivered
CONTACT_EMAIL=info.moislam@gmail.com

# Canonical Site URL used for Open Graph, Sitemap, and Schema.org metadata
# (e.g. https://mohamedelshourbagy.com or your Vercel deployment URL)
NEXT_PUBLIC_SITE_URL=https://mohamedelshourbagy.com
